{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "morning-card.schema.json",
  "type": "array",
  "minItems": 1,
  "maxItems": 10,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["number", "key", "problem", "evidence", "lastSeen", "fix"],
    "properties": {
      "number": { "type": "integer", "minimum": 1, "maximum": 10 },
      "key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[a-z0-9][a-z0-9/-]*$"
      },
      "problem": { "type": "string", "minLength": 1, "maxLength": 200 },
      "evidence": { "type": "string", "minLength": 1, "maxLength": 500 },
      "lastSeen": { "type": "string", "minLength": 1, "maxLength": 200 },
      "fix": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
